        "phi_resonance": 53.83809304113802,
        "consciousness_freq": 9.873042695044237,
        "quantum_harmony": 40.80716473403213,
        "frequency_band": "gamma",
        "phi_pairs": []
      },
      {
        "text": "For the rare and radiant maiden whom the angels name Lenore\u2014",
        "phi_resonance": 25.561460976547483,
        "consciousness_freq": 6.123893717557725,
        "quantum_harmony": 32.211060282716986,
        "frequency_band": "beta",
        "phi_pairs": []
      },
      {
