        "phi_resonance": 8.476801230296042,
        "consciousness_freq": 2.5355697469917122,
        "quantum_harmony": 1.1568377623689121,
        "frequency_band": "theta",
        "phi_pairs": [
          [
            "separate",
            "dying"
          ]
        ]
      },
      {
        "text": "Eagerly I wished the morrow;\u2014vainly I had sought to borrow",
        "phi_resonance": 37.681968473663986,
        "consciousness_freq": 6.293817363329073,
        "quantum_harmony": 32.210075958132194,
        "frequency_band": "beta",
        "phi_pairs": []
      },
      {
