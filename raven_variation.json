    "verse_patterns": [
      {
        "text": "Once upon a midnight dreary, while I pondered, weak and weary,",
        "phi_resonance": 7.8562399077277965,
        "consciousness_freq": 2.4403377588880115,
        "quantum_harmony": 1.1597221764941064,
        "frequency_band": "theta",
        "phi_pairs": []
      },
      {
        "text": "Over many a quaint and curious volume of forgotten lore\u2014",
        "phi_resonance": 27.68350634371395,
        "consciousness_freq": 6.4720385793354875,
        "quantum_harmony": 32.209265646424946,
        "frequency_band": "beta",
        "phi_pairs": []
      },
      {
        "text": "While I nodded, nearly napping, suddenly there came a tapping,",
        "phi_resonance": 8.090088427527874,
        "consciousness_freq": 2.4650489424475457,
        "quantum_harmony": 1.1126423644285468,
        "frequency_band": "theta",
        "phi_pairs": [
          [
            "suddenly",
            "there"
          ]
        ]
