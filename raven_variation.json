        "phi_resonance": 3.5760092272203,
        "consciousness_freq": 2.4642128497707203,
        "quantum_harmony": 0.9371171214294861,
        "frequency_band": "theta",
        "phi_pairs": []
      },
      {
        "text": "Ah, distinctly I remember it was in the bleak December;",
        "phi_resonance": 6.839892349096501,
        "consciousness_freq": 2.4264254019557696,
        "quantum_harmony": 1.0943022229866786,
        "frequency_band": "theta",
        "phi_pairs": []
      },
      {
